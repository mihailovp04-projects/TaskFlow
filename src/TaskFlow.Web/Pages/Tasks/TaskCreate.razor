@page "/tasks/new"
@attribute [Authorize]
@inject ITaskApiClient Api
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>New task - TaskFlow</PageTitle>

<h1>New task</h1>

@if (_projects is null)
{
    <LoadingIndicator />
}
else
{
    <TaskForm Model="_model" Projects="_projects" OnSubmit="CreateAsync" SubmitText="Create" CancelHref="tasks" />
}

@code {
    [SupplyParameterFromQuery]
    public int? ProjectId { get; set; }

    private readonly TaskFormModel _model = new();
    private IReadOnlyList<ProjectDto>? _projects;

    protected override async Task OnInitializedAsync()
    {
        _model.ProjectId = ProjectId;
        _projects = await Api.GetProjectsAsync();
    }

    private async Task CreateAsync(TaskFormModel model)
    {
        try
        {
            var created = await Api.CreateTaskAsync(model.ToCreateRequest());
            await Toasts.ShowAsync($"Task \"{created.Title}\" created.", ToastKind.Success);
            Navigation.NavigateTo($"tasks/{created.Id}");
        }
        catch (Exception ex)
        {
            await Toasts.ShowAsync($"Could not create the task: {ex.Message}", ToastKind.Error);
        }
    }
}