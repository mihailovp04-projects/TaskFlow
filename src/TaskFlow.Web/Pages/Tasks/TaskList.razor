@page "/tasks"
@attribute [Authorize]
@implements IDisposable
@inject ITaskApiClient Api
@inject ILogger<TaskList> Logger
@inject NavigationManager Navigation
@inject AppState AppState
@inject ToastService Toasts

<PageTitle>Tasks - TaskFlow</PageTitle>

<div class="page-header">
    <h1>Tasks</h1>
    <a class="btn btn-primary" href="tasks/new">New task</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <StatusSelector @bind-Value="_status" @bind-Value:after="ApplyFilters" AllowAll="true" />
    </div>
    <div class="col-md-4">
        <select class="form-select" aria-label="Priority" @bind="_priority" @bind:after="ApplyFilters">
            <option value="">All priorities</option>
            @foreach (var priority in Enum.GetValues<TaskPriority>())
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <input class="form-control" placeholder="Search by title" aria-label="Search"
               @bind="_search" @bind:event="oninput"
               @onblur="ApplyFilters" />
    </div>
</div>

<div class="form-check mb-3">
    <input id="hideCompleted" type="checkbox" class="form-check-input"
           checked="@AppState.HideCompleted" @onchange="OnHideCompletedChanged" />
    <label class="form-check-label" for="hideCompleted">Hide completed</label>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_tasks is null)
{
    <LoadingIndicator />
}
else
{
    var visible = VisibleTasks;

    if (visible.Count == 0)
    {
        <EmptyState>No tasks match the filter.</EmptyState>
    }
    else
    {
        <p class="text-muted">Shown: @visible.Count of @_tasks.Count</p>
        <div class="task-grid">
            @foreach (var task in visible)
            {
                <TaskCard @key="task.Id" Item="task" OnDelete="DeleteAsync" OnStatusChange="ChangeStatusAsync" />
            }
        </div>
    }
}

@code {
    private CancellationTokenSource? _loadCts;
    private List<TaskDto>? _tasks;
    private TaskItemStatus? _status;
    private string _priority = string.Empty;
    private string _search = string.Empty;
    private string? _error;

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "priority")]
    public string? PriorityQuery { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    private List<TaskDto> VisibleTasks
    {
        get
        {
            if (_tasks is null)
            {
                return [];
            }

            IEnumerable<TaskDto> visible = _tasks;

            if (AppState.HideCompleted)
            {
                visible = visible.Where(t => t.Status != TaskItemStatus.Done);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                visible = visible.Where(t => t.Title.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return visible.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleStateChanged;
        await UpdateOpenCountAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _status = Enum.TryParse<TaskItemStatus>(StatusQuery, out var status) ? status : null;
        _priority = Enum.TryParse<TaskPriority>(PriorityQuery, out var priority) ? priority.ToString() : string.Empty;
        _search = SearchQuery ?? string.Empty;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        _tasks = null;
        _error = null;

        try
        {
            TaskPriority? priority = Enum.TryParse<TaskPriority>(_priority, out var parsed) ? parsed : null;
            var result = await Api.GetTasksAsync(_status, priority, ct: token);
            _tasks = result.ToList();

            Logger.LogInformation("Loaded {Count} tasks (status={Status}, priority={Priority})", _tasks.Count, _status, priority);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ApplyFilters()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["status"] = _status?.ToString(),
            ["priority"] = string.IsNullOrEmpty(_priority) ? null : _priority,
            ["search"] = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim()
        });
        Navigation.NavigateTo(uri);
    }

    private async Task DeleteAsync(int id)
    {
        var title = _tasks?.FirstOrDefault(t => t.Id == id)?.Title;
        var deleted = await Api.DeleteTaskAsync(id);
        if (deleted)
        {
            _tasks?.RemoveAll(t => t.Id == id);
            await UpdateOpenCountAsync();
            await Toasts.ShowAsync($"Task \"{title}\" deleted.", ToastKind.Success);
        }
        else
        {
            _error = $"Task #{id} was not found.";
        }
    }

    private async Task ChangeStatusAsync(StatusChangeRequest request)
    {
        await Api.ApplyStatusChangeAsync(_tasks, request);
        await UpdateOpenCountAsync();
    }

    private async Task UpdateOpenCountAsync()
    {
        var all = await Api.GetTasksAsync();
        AppState.SetOpenTaskCount(all.Count(t => t.Status != TaskItemStatus.Done));
    }

    private async Task OnHideCompletedChanged(ChangeEventArgs e)
    {
        await AppState.SetHideCompletedAsync(e.Value is true);
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

public void Dispose()
{
    AppState.OnChange -= HandleStateChanged;
    _loadCts?.Cancel();
    _loadCts?.Dispose();
}
}