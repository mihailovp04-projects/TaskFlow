{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TaskFlow": "Debug"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "RequestTiming": {
    "SlowRequestThresholdMs": 200
  },
  "Diagnostics": {
    "Enabled": true
  }
}