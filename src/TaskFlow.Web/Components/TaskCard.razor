<article class="task-card @(IsOverdue ? "overdue" : null) @(Theme?.IsDark == true ? "bg-dark text-white" : null)">
    <header class="task-card-header">
        <a class="task-title @(Theme?.IsDark == true ? "link-light" : null)" href="tasks/@Item.Id">@Item.Title</a>
        <PriorityBadge Priority="Item.Priority" />
    </header>

    <p class="task-meta">
        <span>@TaskDisplay.StatusLabel(Item.Status)</span>
        @if (Item.DueDate is not null)
        {
            <span>due @Item.DueDate.Value.ToString("yyyy-MM-dd")</span>
        }
        @if (IsOverdue)
        {
            <span class="overdue-label">overdue</span>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(Item.Description))
    {
        <p class="task-description">@Item.Description</p>
    }

    <footer class="task-card-actions">
        <a class="btn btn-sm btn-outline-primary" href="tasks/@Item.Id/edit">Edit</a>
        @if (OnStatusChange.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-outline-success"
                    @onclick="() => OnStatusChange.InvokeAsync(new StatusChangeRequest(Item.Id, NextStatus))">
                @StatusButtonText
            </button>
        }
        @if (OnDelete.HasDelegate)
        {
            <ConfirmButton ButtonClass="btn-sm btn-outline-danger" OnConfirmed="() => OnDelete.InvokeAsync(Item.Id)">
                Delete
            </ConfirmButton>
        }
    </footer>
</article>

@code {
    [Parameter, EditorRequired]
    public TaskDto Item { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    [Parameter]
    public EventCallback<StatusChangeRequest> OnStatusChange { get; set; }

    [CascadingParameter]
    private ThemeInfo? Theme { get; set; }

    private string StatusButtonText => Item.Status switch
    {
        TaskItemStatus.Todo => "Start",
        TaskItemStatus.InProgress => "Complete",
        _ => "Reopen"
    };

    private TaskItemStatus NextStatus => Item.Status switch
    {
        TaskItemStatus.Todo => TaskItemStatus.InProgress,
        TaskItemStatus.InProgress => TaskItemStatus.Done,
        _ => TaskItemStatus.Todo
    };

    private bool IsOverdue => TaskDisplay.IsOverdue(Item, DateTime.Today);
}